{
  "mcpServers": {
    "chrome-devtools": {
      "command": "/usr/bin/chrome-devtools-mcp",
      "args": [
        "--headless",
        "--executablePath=/root/.cache/ms-playwright/chromium-1194/chrome-linux/chrome",
        "--chrome-arg=--no-sandbox",
        "--chrome-arg=--disable-setuid-sandbox",
        "--no-usage-statistics"
      ]
    }
  }
}
